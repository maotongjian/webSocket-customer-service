{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "public/index.html" },
    { "src": "/customer-service", "dest": "public/customer-service.html" },
    { "src": "/ws", "dest": "api/ws.js" }
  ]
}
